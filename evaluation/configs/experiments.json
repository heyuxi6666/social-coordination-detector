{
  "seeds": 20,
  "base_seed": 1000,
  "defaults": {},
  "experiments": [
    {"id": "E0_headline", "rq": "RQ1", "trace": true,
     "title": "Coordinated and organic-only scenarios at default settings",
     "configs": [
       {"label": "coordinated", "params": {}},
       {"label": "coordinated, adjacent ids + repost signal", "params": {"id_adjacent": true, "repost_signal": true}},
       {"label": "organic-only", "params": {"group_size": 0}},
       {"label": "organic + loyal followers", "params": {"group_size": 0, "loyal_followers": 35}},
       {"label": "organic + notification burst", "params": {"group_size": 0, "loyal_followers": 35, "loyal_delay_mean": 45}},
       {"label": "coordinated + loyal followers", "params": {"loyal_followers": 35}}
     ]},
    {"id": "E1_jitter", "rq": "RQ2", "title": "Timing jitter (seconds, Gaussian sd per like)",
     "sweep": {"jitter": [0.5, 2, 5, 10, 20, 40]}},
    {"id": "E2_participation", "rq": "RQ2", "title": "Participation rate of group accounts per coordinated post",
     "sweep": {"participation": [1.0, 0.8, 0.6, 0.4, 0.2]}},
    {"id": "E3_organic_audience", "rq": "RQ2", "title": "Organic audience size per post", "null_too": true,
     "sweep": {"organic_audience": [10, 40, 70, 100]}},
    {"id": "E4_heavy_users", "rq": "RQ2", "title": "Heavy-user activity (weight of the 10% heavy accounts)", "null_too": true,
     "sweep": {"heavy_weight": [1, 5, 20, 50]}},
    {"id": "E5_group_size", "rq": "RQ2", "title": "Coordinated group size",
     "sweep": {"group_size": [6, 10, 20, 40, 80]}},
    {"id": "E6_rotation", "rq": "RQ3", "trace": true, "title": "Account rotation (per-slot replacement probability before each coordinated post)",
     "sweep": {"rotation": [0, 0.1, 0.2, 0.4, 0.6, 0.8]}}
  ]
}
